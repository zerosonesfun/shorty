msgid "Shorty Settings"
msgstr "Shorty 設定"

#: includes/admin.php:16
msgid "Shorty"
msgstr "Shorty"

#: includes/admin.php:47
msgid "Shortcuts saved successfully!"
msgstr "ショートカットが正常に保存されました！"

#: includes/admin.php:58
msgid "Ctrl + Shift"
msgstr "Ctrl + Shift"

#: includes/admin.php:59
msgid "Alt + Shift"
msgstr "Alt + Shift"

#: includes/admin.php:60
msgid "Ctrl + Alt"
msgstr "Ctrl + Alt"

#: includes/admin.php:61
msgid "Ctrl + Meta (Cmd on Mac)"
msgstr "Ctrl + Meta (Mac では Cmd)"

#: includes/admin.php:62
